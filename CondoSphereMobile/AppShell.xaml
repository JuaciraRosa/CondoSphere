<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CondoSphereMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CondoSphereMobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="CondoSphereMobile">

    <!-- DASHBOARD (comum a todos) -->
    <FlyoutItem Title="Dashboard" Route="dashboard" x:Name="DashboardFlyout">
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

    <!-- RESIDENT -->
    <FlyoutItem Title="My Area" Route="resident" x:Name="ResidentFlyout">
        <ShellContent Title="My Unit"        ContentTemplate="{DataTemplate local:MyUnitPage}" />
        <ShellContent Title="Quotas"         ContentTemplate="{DataTemplate local:QuotasPage}" />
        <ShellContent Title="Meetings"       ContentTemplate="{DataTemplate local:MeetingsPage}" />
        <ShellContent Title="Occurrences"    ContentTemplate="{DataTemplate local:OccurrencesPage}" />
        <ShellContent Title="Notifications"  ContentTemplate="{DataTemplate local:NotificationsPage}" />
        <ShellContent Title="Voting"         ContentTemplate="{DataTemplate local:VotingPage}" />
    </FlyoutItem>

    <!-- MANAGER -->
    <FlyoutItem Title="Operations" Route="manager" x:Name="ManagerFlyout">
        <ShellContent Title="Condominiums"   ContentTemplate="{DataTemplate local:CondominiumsPage}" />
        <ShellContent Title="Meetings"       ContentTemplate="{DataTemplate local:MeetingsPage}" />
        <ShellContent Title="Expenses"       ContentTemplate="{DataTemplate local:ExpensesPage}" />
        <ShellContent Title="Quotas"         ContentTemplate="{DataTemplate local:QuotasPage}" />
        <ShellContent Title="Payments"       ContentTemplate="{DataTemplate local:PaymentsPage}" />
        <ShellContent Title="Notifications"  ContentTemplate="{DataTemplate local:NotificationsPage}" />
        <ShellContent Title="Occurrences"    ContentTemplate="{DataTemplate local:OccurrencesPage}" />
        <ShellContent Title="Voting"         ContentTemplate="{DataTemplate local:VotingPage}" />
    </FlyoutItem>

    <!-- ADMIN -->
    <FlyoutItem Title="Administration" Route="admin" x:Name="AdminFlyout">
        <ShellContent Title="Users"      ContentTemplate="{DataTemplate local:UsersPage}" />
        <ShellContent Title="Companies"  ContentTemplate="{DataTemplate local:CompaniesPage}" />
    </FlyoutItem>

    <!-- Rodapé com logout -->
    <Shell.FlyoutFooter>
        <Grid Padding="16">
            <Button Text="Logout" Clicked="OnLogoutClicked"/>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
