<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CondoSphereMobile.ViewModels"
             x:Class="CondoSphereMobile.Views.CondominiumsPage"
             Title="Condominiums">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Dashboard"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnBackToDashboardClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.BindingContext>
        <vm:CondominiumsViewModel />
    </ContentPage.BindingContext>

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadCondominiumsCommand}">
        <CollectionView ItemsSource="{Binding Condominiums}" Margin="12">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,0,0,12" BorderColor="#ddd" HasShadow="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Address}" FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>