<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CondoSphereMobile.Views.MessageComposePage"
             Title="Message ComposeP">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Entry x:Name="ToEntry" Placeholder="Para (opcional, default admin@condo.com)" Keyboard="Email" />
            <Entry x:Name="SubjectEntry" Placeholder="Assunto" />
            <Editor x:Name="BodyEditor" Placeholder="Mensagem" AutoSize="TextChanges" />
            <Button Text="Enviar" Clicked="OnSendClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>