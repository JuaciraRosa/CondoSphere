<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CondoSphereMobile.ViewModels"
             x:Class="CondoSphereMobile.Views.PaymentsPage"
             Title="Payments">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Dashboard" Priority="0" Order="Primary" Clicked="OnBackToDashboardClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.BindingContext>
        <vm:PaymentsViewModel/>
    </ContentPage.BindingContext>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadPaymentsCommand}">
        <CollectionView ItemsSource="{Binding Payments}" Margin="12">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,0,0,12" BorderColor="#ddd" HasShadow="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Amount, StringFormat='€ {0:F2}'}" FontAttributes="Bold"/>
                            <Label Text="{Binding Method}" />
                            <Label Text="{Binding Status}" />
                            <Label Text="{Binding PaidAt, StringFormat='Paid: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="Gray"/>
                            <Label Text="{Binding ProviderReference, StringFormat='Ref: {0}'}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>