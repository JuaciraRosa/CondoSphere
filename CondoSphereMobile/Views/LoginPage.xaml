<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CondoSphereMobile.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CondoSphereMobile.ViewModels"
             Title="Login">
    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
            <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />

            <Grid ColumnDefinitions="Auto,*">
                <CheckBox IsChecked="{Binding RememberMe}" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="Remember me" VerticalOptions="Center"/>
            </Grid>

            <Button Text="Entrar" Command="{Binding LoginCommand}" />

            <Label Text="Esqueci a senha" TextDecorations="Underline"
             HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>