<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CondoSphereMobile.Views.MaintenanceMyPage"
            Title="Minhas Manutenções">
    <VerticalStackLayout Padding="16" Spacing="10">
        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False"/>
        <Button Text="Novo Pedido" Clicked="OnNewClicked"/>
        <CollectionView x:Name="ListView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="6" HasShadow="False" BorderColor="#ddd">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold"/>
                            <Label Text="{Binding Description}"/>
                            <Label Text="{Binding Status, StringFormat='Estado: {0}'}" FontSize="12" TextColor="Gray"/>
                            <Label Text="{Binding SubmittedAt, StringFormat='Enviado: {0:dd/MM HH:mm}'}" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>