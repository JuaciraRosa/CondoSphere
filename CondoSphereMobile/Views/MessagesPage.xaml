<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CondoSphereMobile.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CondoSphereMobile.ViewModels"
    xmlns:models="clr-namespace:CondoSphereMobile.Models"
    Title="Messages">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Dashboard" Priority="0" Order="Primary" Clicked="OnBackToDashboardClicked" />
        <ToolbarItem Text="Novo" Priority="1" Order="Primary" Clicked="OnNewClicked" />
        <ToolbarItem Text="Só as minhas" Priority="2" Order="Secondary" Clicked="OnToggleScopeClicked" />
    </ContentPage.ToolbarItems>

 

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Messages}" Margin="12" SelectionMode="None">
            <CollectionView.EmptyView>
                <Grid Padding="24">
                    <Label Text="Sem mensagens." HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MessageDto">
                    <Frame Padding="10" Margin="0,0,0,12" HasShadow="False" BorderColor="#ddd">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Subject}" FontAttributes="Bold"/>
                            <Label Text="{Binding Body}" LineBreakMode="TailTruncation" MaxLines="2"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding FromEmail}" FontSize="12" Opacity="0.7"/>
                                <Label Grid.Column="1"
                                       Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                       FontSize="12" Opacity="0.7"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
