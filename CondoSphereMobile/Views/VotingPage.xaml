<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CondoSphereMobile.Views.VotingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CondoSphereMobile.Models"
    Title="Voting">

    <Grid RowDefinitions="Auto,*" Padding="12">
        <Button Text="Recarregar" Clicked="OnReloadClicked" />

        <!-- Se preferir binding, descomente a linha abaixo e exponha Votes no BindingContext -->
        <!-- ItemsSource="{Binding Votes}" -->
        <CollectionView Grid.Row="1" x:Name="List" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VoteDto">
                    <VerticalStackLayout Padding="12"
                                         Margin="0,6"
                                         BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#222}">
                        <Label Text="{Binding Question}" FontAttributes="Bold" />
                        <Picker Title="Escolha uma opção"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding Selected}" />
                        <Button Text="Votar"
                                Clicked="OnVoteClicked"
                                CommandParameter="{Binding .}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
