<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CondoSphereMobile.Views.OccurrenceCreatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nova Ocorrência">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">




            <Label Text="Condomínio" />
            <Picker x:Name="CondoPicker"
                    Title="Selecione o condomínio"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedIndexChanged="OnCondoChanged" />

            <Label Text="Unidade" />
            <Picker x:Name="UnitPicker"
                    Title="Selecione a unidade"
                    ItemDisplayBinding="{Binding Display}" />

            <Label Text="Título" />
            <Entry x:Name="TitleEntry" Placeholder="Título" />

            <Label Text="Descrição" />
            <Editor x:Name="DescEntry" Placeholder="Descrição" AutoSize="TextChanges" />

            <Label Text="Seu e-mail" />
            <Entry x:Name="EmailEntry" Placeholder="email@exemplo.com" Keyboard="Email" />

            <Button Text="Criar" Clicked="OnCreateClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
