<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CondoSphereMobile.ViewModels"
             x:Class="CondoSphereMobile.Views.QuotasPage"
             Title="Quotas">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Dashboard" Priority="0" Order="Primary" Clicked="OnBackToDashboardClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.BindingContext>
        <vm:QuotasViewModel/>
    </ContentPage.BindingContext>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadQuotasCommand}">
        <CollectionView ItemsSource="{Binding Quotas}" Margin="12">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,0,0,12" BorderColor="#ddd" HasShadow="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Amount, StringFormat='€ {0:F2}'}" FontAttributes="Bold"/>
                            <Label Text="{Binding DueDate, StringFormat='{0:yyyy-MM-dd}'}"/>
                            <Label Text="{Binding IsPaid, StringFormat='Paid: {0}'}"/>
                            <Label Text="{Binding UnitId, StringFormat='Unit: {0}'}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
