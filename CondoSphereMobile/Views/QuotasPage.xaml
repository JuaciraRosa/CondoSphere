<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CondoSphereMobile.Views.QuotasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CondoSphereMobile.Models"
    xmlns:conv="clr-namespace:CondoSphereMobile.Converters"
    Title="Quotas">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolNegationConverter x:Key="Not" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="12">
        <HorizontalStackLayout Spacing="12">
            <Button Text="Recarregar" Clicked="OnReloadClicked" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />
        </HorizontalStackLayout>

        <!-- Se preferir binding: ItemsSource="{Binding Quotas}" -->
        <CollectionView x:Name="List" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:QuotaDto">
                    <Grid Padding="12" Margin="0,6"
                          ColumnDefinitions="*,Auto"
                          BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#222}">
                        <VerticalStackLayout>
                            <Label Text="{Binding UnitNumber}" FontAttributes="Bold" />
                            <Label Text="{Binding DueDateStr}" Opacity="0.7" FontSize="12" />
                            <Label Text="{Binding AmountPt}" />
                            <Label Text="{Binding IsPaid, StringFormat='Pago: {0}'}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Button Text="Detalhes"
                                    Clicked="OnDetailsClicked"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Pagar" Clicked="OnDetailsClicked" CommandParameter="{Binding}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
