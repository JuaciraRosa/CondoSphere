<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CondoSphereMobile.Views.QuotasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Quotas">

    <Grid RowDefinitions="Auto, *" Padding="12">
        <HorizontalStackLayout Spacing="12">
            <Button Text="Recarregar" Clicked="OnReloadClicked" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
        </HorizontalStackLayout>

        <CollectionView
            x:Name="List"
            Grid.Row="1"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:QuotaDto"
                              xmlns:models="clr-namespace:CondoSphereMobile.Models">
                    <Grid Padding="12" ColumnDefinitions="*, Auto" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#222}" Margin="0,6" >
                        <VerticalStackLayout>
                            <Label Text="{Binding UnitNumber}" FontAttributes="Bold" />
                            <Label Text="{Binding DueDateStr}" Opacity="0.7" FontSize="12" />
                            <Label Text="{Binding AmountPt}" />
                            <Label Text="{Binding IsPaid, StringFormat='Pago: {0}'}" />
                        </VerticalStackLayout>

                        <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Button Text="Detalhes" Clicked="OnDetailsClicked" CommandParameter="{Binding .}" />
                            <Button Text="Pagar"
                                    IsEnabled="{Binding IsPaid, Converter={StaticResource invertBoolConverter}}"
                                    Clicked="OnPayClicked"
                                    CommandParameter="{Binding .}" />
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
