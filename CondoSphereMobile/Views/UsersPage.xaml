<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CondoSphereMobile.ViewModels"
             x:Class="CondoSphereMobile.Views.UsersPage"
             Title="Users">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Dashboard" Priority="0" Order="Primary" Clicked="OnBackToDashboardClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.BindingContext>
        <vm:UsersViewModel/>
    </ContentPage.BindingContext>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadUsersCommand}">
        <CollectionView ItemsSource="{Binding Users}" Margin="12">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,0,0,12" BorderColor="#ddd" HasShadow="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding FullName}" FontAttributes="Bold" />
                            <Label Text="{Binding Email}" TextColor="Gray"/>
                            <Label Text="{Binding Role}" />
                            <Label Text="{Binding IsActive, StringFormat='Active: {0}'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>