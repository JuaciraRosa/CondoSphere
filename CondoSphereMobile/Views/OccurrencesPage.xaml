<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CondoSphereMobile.Views.OccurrencesPage"
             Title="Ocorrências">
    <!-- raiz em Grid para permitir um overlay por cima da lista -->
    <Grid>

      
        <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="10">
         
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
                <Button Grid.Column="1" Text="Nova Ocorrência" Clicked="OnNewClicked"/>
            </Grid>

            <Label Grid.Row="1" Text="Ocorrências" FontAttributes="Bold" IsVisible="False"/>

            <!-- Lista -->
            <CollectionView x:Name="ListView" Grid.Row="2">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="6" HasShadow="False" BorderColor="#ddd">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontAttributes="Bold"/>
                                <Label Text="{Binding Description}"/>
                                <HorizontalStackLayout>
                                    <Label Text="{Binding Status}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding CreatedAt, StringFormat=' • {0:dd/MM HH:mm}'}"
                                           FontSize="12" TextColor="Gray"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- OVERLAY DE CRIAÇÃO (invisível por defeito) -->
        <Grid x:Name="CreateOverlay" BackgroundColor="#80000000" IsVisible="False"
              Padding="24" RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*">
            <!-- centra o card -->
            <Frame Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White"
                   WidthRequest="320" >
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nova ocorrência" FontAttributes="Bold" FontSize="18" />

                    <!-- pickers dentro do overlay -->
                    <Picker x:Name="CreateCondoPicker" Title="Condomínio"
                            SelectedIndexChanged="OnCreateCondoChanged"/>
                    <Picker x:Name="CreateUnitPicker" Title="Unidade" IsEnabled="False"/>

                    <Entry x:Name="TitleEntry" Placeholder="Título"/>
                    <Editor x:Name="DescEditor" Placeholder="Descreva a ocorrência" AutoSize="TextChanges" />
                    <Entry x:Name="EmailEntry" Placeholder="Email de contacto" Keyboard="Email"/>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Label />
                        <Button Grid.Column="1" Text="Cancelar" Clicked="OnCreateCancel"/>
                        <Button Grid.Column="2" Text="OK" Clicked="OnCreateOk"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
