<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CondoSphereMobile.Views.OccurrencesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CondoSphereMobile.Models"
    Title="Ocorrências">

    <Grid RowDefinitions="Auto, *" Padding="12">
        <HorizontalStackLayout Spacing="12">
            <Button Text="Nova ocorrência" Clicked="OnNewClicked" />
            <Button Text="Recarregar" Clicked="OnReloadClicked" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1" x:Name="List" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OccurrenceDto">
                    <Grid Padding="12" ColumnDefinitions="*, Auto" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#222}" Margin="0,6" >
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="{Binding Status, StringFormat='Estado: {0}'}" />
                            <Label Text="{Binding CreatedAt, StringFormat='Criada em: {0:dd/MM/yyyy HH:mm}'}" FontSize="12" Opacity="0.7" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding UnitNumber}" />
                            <Label Text="{Binding CondominiumId, StringFormat='Cond: {0}'}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
