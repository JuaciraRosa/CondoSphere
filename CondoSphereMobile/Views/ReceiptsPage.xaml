<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CondoSphereMobile.Views.ReceiptsPage"
             Title="ReceiptsPage">


    <VerticalStackLayout Padding="16" Spacing="12">
        <CollectionView ItemsSource="{Binding Payments}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12">
                        <VerticalStackLayout>
                            <Label Text="{Binding Id, StringFormat='Pagamento #{0}'}" FontAttributes="Bold"/>
                            <Label Text="{Binding Amount, StringFormat='Valor: {0:C}'}"/>
                            <Label Text="{Binding Status}" />
                            <Button Text="Descarregar Recibo"
                                    Command="{Binding BindingContext.DownloadReceiptCommand, Source={x:Reference Name=PageRoot}}"
                                    CommandParameter="{Binding Id}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="{Binding ReceiptSavedPath}" IsVisible="{Binding ReceiptSavedPath}" />
    </VerticalStackLayout>
</ContentPage>