<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CondoSphereMobile.Views.PaymentMethodPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pagamento">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label x:Name="QuotaLabel" FontAttributes="Bold" />
        <Button Text="Pagar com Cartão" Clicked="OnPayCard" />
        <Button Text="Voltar" Clicked="OnCancel" />
    </VerticalStackLayout>
</ContentPage>
