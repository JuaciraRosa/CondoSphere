<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CondoSphereMobile.Views.ForgotPasswordPage"
                      Title="Recuperar senha">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Informe o seu email. Enviaremos um link para redefinir a senha." />
            <Entry x:Name="EmailEntry" Placeholder="email@exemplo.com" Keyboard="Email" />
            <Button Text="Enviar" Clicked="OnSendClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>