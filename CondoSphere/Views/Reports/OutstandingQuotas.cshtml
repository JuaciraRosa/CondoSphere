@model IEnumerable<CondoSphere.Models.Quota>
@using System.Globalization
@{
    var pt = CultureInfo.GetCultureInfo("pt-PT");
    ViewData["Title"] = "Quotas em Aberto";
}

<h2>Quotas em Aberto</h2>

<div class="card">
    <div class="table-responsive">
        <table class="table">
            <thead>
            <tr>
                <th>Condomínio</th>
                <th>Unidade</th>
                <th>Valor</th>
                <th>Vencimento</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var q in Model)
            {
                <tr>
                    <td>@(q.Unit?.Condominium?.Name)</td>
                    <td>@(q.Unit?.Number ?? $"{q.UnitId}")</td>
                    <td>@q.Amount.ToString("C", pt)</td>
                    <td>@q.DueDate.ToString("dd/MM/yyyy")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Sem quotas em aberto.</p>
}
