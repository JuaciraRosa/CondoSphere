@model CondoSphere.ViewModels.PollCreateVm
@{
    ViewData["Title"] = "Create Poll";
}

<div class="container-xl">
  <div class="card">
    <div class="card-header"><h3 class="card-title">Create Poll</h3></div>
    <div class="card-body">
      <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
          <label asp-for="Title" class="form-label"></label>
          <input asp-for="Title" class="form-control"/>
          <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Description" class="form-label"></label>
          <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label asp-for="StartsAtUtc" class="form-label">Starts (UTC)</label>
            <input asp-for="StartsAtUtc" type="datetime-local" class="form-control"/>
            <span asp-validation-for="StartsAtUtc" class="text-danger"></span>
          </div>
          <div class="col-md-6">
            <label asp-for="EndsAtUtc" class="form-label">Ends (UTC)</label>
            <input asp-for="EndsAtUtc" type="datetime-local" class="form-control"/>
            <span asp-validation-for="EndsAtUtc" class="text-danger"></span>
          </div>
        </div>

        <div class="mb-3 mt-3">
          <label asp-for="CondominiumId" class="form-label"></label>
          <select asp-for="CondominiumId" asp-items="ViewBag.CondominiumId" class="form-select"></select>
          <span asp-validation-for="CondominiumId" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
          <input asp-for="AllowSingleChoice" class="form-check-input" />
          <label asp-for="AllowSingleChoice" class="form-check-label">Single choice (one vote)</label>
        </div>

        <div class="mb-2">
          <label class="form-label">Options</label>
          <div id="optWrap">
            @for (var i = 0; i < Model.Options.Count; i++)
            {
                <div class="input-group mb-2">
                  <input class="form-control" name="Options[@i]" value="@Model.Options[i]" placeholder="Option text" />
                  <button class="btn btn-outline-secondary" type="button" onclick="this.parentElement.remove()">Remove</button>
                </div>
            }
          </div>
          <button class="btn btn-sm btn-outline-primary" type="button" onclick="addOpt()">Add option</button>
          <span asp-validation-for="Options" class="text-danger"></span>
        </div>

        <div class="mt-3 d-flex gap-2">
          <button class="btn btn-primary">Save</button>
          <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts{
  <partial name="_ValidationScriptsPartial"/>
  <script>
    function addOpt(){
      const idx = document.querySelectorAll('#optWrap .input-group').length;
      const div = document.createElement('div');
      div.className = 'input-group mb-2';
      div.innerHTML = `<input class="form-control" name="Options[${idx}]" placeholder="Option text"/>
                       <button class="btn btn-outline-secondary" type="button" onclick="this.parentElement.remove()">Remove</button>`;
      document.getElementById('optWrap').appendChild(div);
    }
  </script>
}
