@model IEnumerable<CondoSphere.Models.Meeting>
@{
    ViewData["Title"] = "Meetings";
     bool isAdmin = User.IsInRole("Administrator") || User.IsInRole("Manager");
}

@section PageHeader {
    <section class="page-title">
        <div class="container">
            <h1>Meetings</h1>
            <div class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li>Meetings</li>
                </ol>
            </div>
        </div>
    </section>
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title"><i class="ti ti-calendar-event"></i> Meetings</h2>
            </div>
            <div class="col-auto ms-auto">
              <div class="col-auto ms-auto">
  @if (isAdmin)
  {
    <a asp-action="Create" class="btn btn-primary">
      <i class="ti ti-plus"></i> Create New Meeting
    </a>
  }
</div>

            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Scheduled Date</th>
                            <th>Agenda</th>
                            <th>Minutes Document</th>
                            <th>Condominium</th>
                              <th>Online</th>
    <th class="text-end">@((isAdmin) ? "Actions" : "Details")</th>
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ScheduledDate</td>
                                <td>@item.Agenda</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.MinutesDocumentPath))
                                    {
                                        <a asp-action="Download" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">Download</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>@item.Condominium?.Name</td>
                                <td>@item.Condominium?.Company?.Name</td>

                                <td>
                                    @if (item.IsOnline)
                                    {
                                        <div><strong>Provedor:</strong> @item.OnlineProvider</div>
                                        <div class="mt-1 d-flex gap-2">
                                            @if (!string.IsNullOrWhiteSpace(item.OnlineJoinUrl))
                                            {
                                                <a class="btn btn-sm btn-primary"
                                                   href="@item.OnlineJoinUrl"
                                                   target="_blank" rel="noopener">
                                                    Link para participantes
                                                </a>
                                            }
                                            @if ((User.IsInRole("Administrator") || User.IsInRole("Manager")) 
                                                 && !string.IsNullOrWhiteSpace(item.OnlineStartUrl))
                                            {
                                                <a class="btn btn-sm btn-outline-dark"
                                                   href="@item.OnlineStartUrl"
                                                   target="_blank" rel="noopener">
                                                    Link do host
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                            <td class="text-end">
  <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">
    <i class="bi bi-eye"></i>
  </a>

  @if (isAdmin)
  {
    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">
      <i class="bi bi-pencil"></i>
    </a>
    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">
      <i class="bi bi-trash"></i>
    </a>
  }
</td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
