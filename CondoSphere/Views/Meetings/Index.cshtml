@model IEnumerable<CondoSphere.Models.Meeting>
@{
    ViewData["Title"] = "Meetings";
}

@section PageHeader {
    <section class="page-title">
        <div class="container">
            <h1>Meetings</h1>
            <div class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li>Meetings</li>
                </ol>
            </div>
        </div>
    </section>
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title"><i class="ti ti-calendar-event"></i> Meetings</h2>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="ti ti-plus"></i> Create New Meeting
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Scheduled Date</th>
                            <th>Agenda</th>
                            <th>Minutes Document</th>
                            <th>Condominium</th>
                            <th>Company</th>  
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ScheduledDate</td>
                                <td>@item.Agenda</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.MinutesDocumentPath))
                                    {
                                        <a asp-action="Download" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">Download</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>@(item.Condominium?.Name)</td>
                                <td>@(item.Condominium?.Company?.Name)</td>  @* aqui mostra a empresa *@
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye"></i></a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i></a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
