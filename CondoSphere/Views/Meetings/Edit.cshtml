@model CondoSphere.Models.Meeting
@{
    ViewData["Title"] = "Edit";
}

<div class="container-xl">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-edit"></i> Edit Meeting</h3>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                <input type="hidden" asp-for="Id" />

                <!-- mantém o caminho do ficheiro existente se não houver upload novo -->
                <input type="hidden" asp-for="MinutesDocumentPath" />

                <div class="mb-3">
                    <label asp-for="ScheduledDate" class="form-label"></label>
                    <input asp-for="ScheduledDate" class="form-control" />
                    <span asp-validation-for="ScheduledDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Agenda" class="form-label"></label>
                    <input asp-for="Agenda" class="form-control" />
                    <span asp-validation-for="Agenda" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Minutes Document</label>

                    @* Documento atual *@
                    @if (!string.IsNullOrWhiteSpace(Model.MinutesDocumentPath))
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="text-muted">Atual:</span>
                            <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="ti ti-download"></i> Download atual
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted mb-2">Nenhum documento anexado.</div>
                    }

                    @* Novo upload (opcional) *@
                    <label asp-for="MinutesFile" class="form-label">Substituir por novo (opcional)</label>
                    <input asp-for="MinutesFile" type="file" class="form-control" accept=".pdf,.doc,.docx" />
                    <span class="form-text">PDF, DOC ou DOCX, até 5 MB.</span>
                    <span asp-validation-for="MinutesFile" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CondominiumId" class="form-label"></label>
                    <select asp-for="CondominiumId" class="form-select" asp-items="ViewBag.CondominiumId"></select>
                    <span asp-validation-for="CondominiumId" class="text-danger"></span>
                </div>

<div class="mb-3 form-check">
  <input asp-for="IsOnline" class="form-check-input" id="isOnlineChk" />
  <label class="form-check-label" for="isOnlineChk">Reunião online</label>
</div>


<div class="mb-3" id="provRow">
  <label class="form-label">Provedor</label>
  <select asp-for="OnlineProvider" class="form-select" id="providerSel">
    <option value="Zoom">Zoom</option>
    <option value="Teams">Microsoft Teams</option>
     <option value="Google">Google</option>
  </select>
</div>


<div class="mt-3 d-flex gap-2">
  <button type="submit" class="btn btn-primary">
    <i class="ti ti-device-floppy"></i> Save
  </button>
  <a asp-action="Index" class="btn btn-secondary">
    <i class="ti ti-arrow-left"></i> Cancel
  </a>
</div>
</form>


@section Scripts{
  <script>
    (function(){
      const chk = document.getElementById('isOnlineChk');
      const row = document.getElementById('provRow');
      function toggle(){ row.style.display = chk.checked ? '' : 'none'; }
      chk?.addEventListener('change', toggle);
      toggle();
    })();
  </script>
}
