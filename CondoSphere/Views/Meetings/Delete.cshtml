@model CondoSphere.Models.Meeting
@{
    ViewData["Title"] = "Delete";
}

<div class="container-xl">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h3 class="card-title"><i class="ti ti-trash"></i> Delete Meeting</h3>
        </div>

        <div class="card-body">
            <h5>Are you sure you want to delete this meeting?</h5>

            <dl class="row mt-3">
                <dt class="col-sm-3">Scheduled Date</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.ScheduledDate)</dd>

                <dt class="col-sm-3">Agenda</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Agenda)</dd>

                <dt class="col-sm-3">Minutes Document</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.MinutesDocumentPath))
                    {
                        <a asp-action="Download" asp-route-id="@Model.Id"
                           class="btn btn-sm btn-outline-primary">
                            Download ata
                        </a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </dd>

                <dt class="col-sm-3">Condominium</dt>
                <dd class="col-sm-9">@Model.Condominium?.Name</dd>
            </dl>
        </div>

        <div class="card-footer">
            <form class="mt-4 d-flex gap-2" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
