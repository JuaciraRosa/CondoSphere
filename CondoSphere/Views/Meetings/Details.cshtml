@model CondoSphere.Models.Meeting
@{
    ViewData["Title"] = "Details";
}

<div class="container-xl">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-info-circle"></i> Meeting Details</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Scheduled Date</dt>
                <dd class="col-sm-9">@Model.ScheduledDate</dd>

                <dt class="col-sm-3">Agenda</dt>
                <dd class="col-sm-9">@Model.Agenda</dd>

                <dt class="col-sm-3">Minutes Document</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.MinutesDocumentPath))
                    {
                        <a asp-action="Download" asp-route-id="@Model.Id"
                           class="btn btn-sm btn-outline-primary">Download</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </dd>

                <dt class="col-sm-3">Condominium</dt>
                <dd class="col-sm-9">@Model.Condominium?.Name</dd>

                <dt class="col-sm-3">Company</dt>
                <dd class="col-sm-9">@Model.Condominium?.Company?.Name</dd>
            </dl>
        </div>
        <div class="mt-4 d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
