@model CondoSphere.Models.Meeting
@{
    ViewData["Title"] = "Details";

      var minutesPath = Model?.MinutesDocumentPath ?? string.Empty;
    var ext = !string.IsNullOrWhiteSpace(minutesPath)
        ? System.IO.Path.GetExtension(minutesPath).ToLowerInvariant()
        : string.Empty;

    var isPdf = ext == ".pdf";
}

<div class="container-xl">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-info-circle"></i> Meeting Details</h3>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Scheduled Date</dt>
                <dd class="col-sm-9">
                    @Model.ScheduledDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </dd>

                <dt class="col-sm-3">Agenda</dt>
                <dd class="col-sm-9">@Model.Agenda</dd>

           <dt class="col-sm-3">Minutes Document</dt>
<dd class="col-sm-9">
    @if (!string.IsNullOrWhiteSpace(Model.MinutesDocumentPath))
    {
        <a asp-action="Download"
           asp-route-id="@Model.Id"
           class="btn btn-sm btn-outline-primary me-2">
            Download
        </a>

        @* Preview inline só para PDF *@
        @if (isPdf)
        {
            <div class="mt-3">
                <iframe src="@Url.Content(Model.MinutesDocumentPath)"
                        style="width:100%;height:70vh;border:1px solid #eee;border-radius:8px"></iframe>
            </div>
        }
        else
        {
            <span class="text-muted small">Preview disponível apenas para PDF.</span>
        }
    }
    else
    {
        <span class="text-muted">Sem documento de atas.</span>
    }
</dd>

                <dt class="col-sm-3">Online</dt>
                <dd class="col-sm-9">
                    @if (Model.IsOnline)
                    {
                        <div><strong>Provedor:</strong> @Model.OnlineProvider</div>
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            @if (!string.IsNullOrWhiteSpace(Model.OnlineJoinUrl))
                            {
                                <a class="btn btn-sm btn-primary"
                                   href="@Model.OnlineJoinUrl"
                                   target="_blank" rel="noopener">
                                    Link para participantes
                                </a>
                            }
                            @if ((User.IsInRole("Administrator") || User.IsInRole("Manager")) && !string.IsNullOrWhiteSpace(Model.OnlineStartUrl))
                            {
                                <a class="btn btn-sm btn-outline-dark"
                                   href="@Model.OnlineStartUrl"
                                   target="_blank" rel="noopener">
                                    Link do host
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </dd>

                <dt class="col-sm-3">Condominium</dt>
                <dd class="col-sm-9">@Model.Condominium?.Name</dd>

                <dt class="col-sm-3">Company</dt>
                <dd class="col-sm-9">@Model.Condominium?.Company?.Name</dd>
            </dl>
        </div>

        <div class="mt-4 px-3 pb-3 d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Back
            </a>

            @if (User.IsInRole("Administrator") || User.IsInRole("Manager"))
            {
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
