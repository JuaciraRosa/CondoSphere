@model CondoSphere.Models.Unit
@using System.Security.Claims

@{
    ViewData["Title"] = "Unit Details";

    // quem é staff?
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("role")?.Value;
    var isStaff = string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase)
               || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase);
}

<div class="card shadow-sm p-4">
  <dl class="row">
    <dt class="col-sm-3">Number</dt>      <dd class="col-sm-9">@Model.Number</dd>
    <dt class="col-sm-3">Area</dt>        <dd class="col-sm-9">@Model.Area</dd>
    <dt class="col-sm-3">Condominium</dt> <dd class="col-sm-9">@Model.Condominium?.Name</dd>
    <dt class="col-sm-3">Owner</dt>       <dd class="col-sm-9">@(Model.Owner?.FullName ?? Model.Owner?.Email)</dd>
  </dl>


  <hr />
  <p>
    Status:
    @(Model.IsActive
        ? Html.Raw("<span class='badge bg-success'>Active</span>")
        : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))
  </p>


  @if (Model.OwnershipHistory != null && Model.OwnershipHistory.Any())
  {
    <h5>Ownership history</h5>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Owner</th>
            <th>Start</th>
            <th>End</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var h in Model.OwnershipHistory.OrderByDescending(x => x.StartAt))
        {
          <tr>
            <td>@(h.Owner?.FullName ?? h.Owner?.Email ?? "—")</td>
            <td>@h.StartAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@(h.EndAt.HasValue ? h.EndAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "— (current)")</td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  }

  <div class="mt-3">
 
    @if (isStaff)
    {
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
  </div>
</div>
