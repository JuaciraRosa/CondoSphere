@model IEnumerable<CondoSphere.Models.Unit>
@{
    ViewData["Title"] = "Units";
}
<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>@Html.DisplayNameFor(m => m.Number)</th>
        <th>@Html.DisplayNameFor(m => m.Area)</th>
        <th>Condominium</th>
        <th>Owner</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
      <tr>
        <td>@item.Number</td>
        <td>@item.Area</td>
        <td>@item.Condominium?.Name</td>  <!-- nome -->
        <td>@(item.Owner?.FullName ?? item.Owner?.Email)</td>  <!-- nome/email -->
        <td class="text-end">
          <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
          <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Details</a>
          <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
        </td>
      </tr>
    }
    </tbody>
  </table>
</div>
