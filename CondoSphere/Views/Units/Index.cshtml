@model IEnumerable<CondoSphere.Models.Unit>
@using System.Security.Claims
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Units";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("role")?.Value;
    var isStaff = string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase)
               || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase);

  
    var p  = ViewBag.Page is int pp ? pp : 1;
    var tp = ViewBag.TotalPages is int tpp ? tpp : 1;
    int? c = ViewBag.CondominiumId as int?;
    string n = ViewBag.Number as string ?? "";
}

<div class="d-flex align-items-center justify-content-between mb-3">
  <h2 class="mb-0">Units</h2>
  @if (isStaff)
  {
    <a asp-action="Create" class="btn btn-primary">
      <i class="bi bi-plus-circle"></i> Create Unit
    </a>
  }
</div>

@if (TempData["Success"] is string ok && !string.IsNullOrEmpty(ok))
{
  <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err && !string.IsNullOrEmpty(err))
{
  <div class="alert alert-danger">@err</div>
}

<form method="get" class="row g-2 mb-3">
  <div class="col-md-4">
    <label class="form-label">Condominium</label>
    <select name="condominiumId" class="form-select" asp-items="ViewBag.FilterCondominiums">
      <option value="">— All —</option>
    </select>
  </div>
  <div class="col-md-4">
    <label class="form-label">Unit number</label>
    <input name="number" class="form-control" value="@n" />
  </div>
  <div class="col-md-2 d-flex align-items-end">
    <button class="btn btn-outline-secondary w-100">Filter</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Number</th>
        <th>Area</th>
        <th>Condominium</th>
        <th>Owner</th>
        <th>Status</th> 
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
      <tr>
        <td>@item.Number</td>
        <td>@item.Area</td>
        <td>@item.Condominium?.Name</td>
        <td>@(item.Owner?.FullName ?? item.Owner?.Email)</td>

        <td>
          @(item.IsActive
              ? Html.Raw("<span class='badge bg-success'>Active</span>")
              : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))
        </td>

        <td class="text-end">
          <a asp-action="Details" asp-route-id="@item.Id"
             class="btn btn-sm btn-outline-info">
            <i class="bi bi-eye"></i> Details
          </a>

          @if (isStaff)
          {
            <a asp-action="Edit" asp-route-id="@item.Id"
               class="btn btn-sm btn-outline-primary">
              <i class="bi bi-pencil"></i> Edit
            </a>

            @if (item.IsActive)
            {
            
              <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-warning">
                  <i class="bi bi-slash-circle"></i> Deactivate
                </button>
              </form>
            }
            else
            {
          
              <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-success">
                  <i class="bi bi-check-circle"></i> Activate
                </button>
              </form>
            }

           
            <a asp-action="Delete" asp-route-id="@item.Id"
               class="btn btn-sm btn-outline-danger d-none">
              <i class="bi bi-trash"></i> Delete
            </a>
          }
        </td>
      </tr>
    }
    </tbody>
  </table>

  @if (tp > 1)
  {
    <nav class="mt-3">
      <ul class="pagination">
        <li class="page-item @(p<=1 ? "disabled" : "")">
          <a class="page-link"
             asp-action="Index"
             asp-route-condominiumId="@c"
             asp-route-number="@n"
             asp-route-page="@(Math.Max(1, p-1))">Anterior</a>
        </li>

        <li class="page-item disabled">
          <span class="page-link">@p / @tp</span>
        </li>

        <li class="page-item @(p>=tp ? "disabled" : "")">
          <a class="page-link"
             asp-action="Index"
             asp-route-condominiumId="@c"
             asp-route-number="@n"
             asp-route-page="@(Math.Min(tp, p+1))">Seguinte</a>
        </li>
      </ul>
    </nav>
  }
</div>
