@model CondoSphere.Models.Unit

@{
    ViewData["Title"] = "Edit Unit";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Unit</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Number" class="form-label"></label>
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Area" class="form-label"></label>
                <input asp-for="Area" class="form-control" />
                <span asp-validation-for="Area" class="text-danger"></span>
            </div>

          <div class="mb-3">
    <label asp-for="CondominiumId" class="form-label">Condominium</label>
    <select asp-for="CondominiumId" class="form-select" asp-items="ViewBag.CondominiumId">
        <option value="">— Select —</option>
    </select>
    <span asp-validation-for="CondominiumId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="OwnerId" class="form-label">Owner</label>
    <select asp-for="OwnerId" class="form-select" asp-items="ViewBag.OwnerId">
        <option value="">— Select —</option>
    </select>
    <span asp-validation-for="OwnerId" class="text-danger"></span>
</div>


            <div class="text-end">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts{
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
  <script>
    (function(){
      const condo = document.querySelector('select[name="CondominiumId"]');
      const owner = document.querySelector('select[name="OwnerId"]');
      if (!condo || !owner) return;

      async function reloadOwners(){
        const id = condo.value;
        const current = owner.value;
        owner.innerHTML = '<option value="">— Select —</option>';
        if(!id) return;

        try{
          const r = await fetch(`/Units/OwnersByCondominium?condominiumId=${encodeURIComponent(id)}`);
          if(!r.ok) return;
          const items = await r.json(); // [{value,text}]
          for(const it of items){
            const opt = document.createElement('option');
            opt.value = it.value;
            opt.textContent = it.text;
            owner.appendChild(opt);
          }
          if (current) owner.value = current; // mantém seleção atual
        } catch(e){ /* silencia */ }
      }

      condo.addEventListener('change', reloadOwners);
      // carrega ao abrir (útil no Edit)
      if (condo.value) reloadOwners();
    })();
  </script>
}
