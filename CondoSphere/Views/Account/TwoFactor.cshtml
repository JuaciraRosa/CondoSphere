@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = "_Layout";
}

<div class="container py-4">
  <h2 class="mb-3">Two-Factor Authentication</h2>

  @if (TempData["Error"] != null)
  {
      <div class="alert alert-danger">@TempData["Error"]</div>
  }
  @if (TempData["Success"] != null)
  {
      <div class="alert alert-success">@TempData["Success"]</div>
  }

  @if (ViewBag.Enabled == true)
  {
      <!-- 2FA já ATIVADO -->
      <div class="alert alert-success">
        2FA is currently <strong>enabled</strong> for your account.
      </div>

      <div class="card p-4 shadow-sm mb-3">
        <h5 class="mb-3">Recovery codes</h5>
        <p class="text-muted mb-3">
          You can generate a new set of 10 one-time recovery codes. Generating new codes will invalidate any previous codes.
        </p>

        <form asp-action="GenerateRecoveryCodes" method="post" class="d-inline">
          @Html.AntiForgeryToken()
          <button class="btn btn-outline-secondary">Generate new recovery codes</button>
        </form>

        <form asp-action="DisableTwoFactor" method="post" class="d-inline ms-2">
          @Html.AntiForgeryToken()
          <button class="btn btn-outline-danger">Disable 2FA</button>
        </form>
      </div>
  }
  else
  {
      <!-- 2FA AINDA NÃO ATIVADO -->
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body text-center">
              <h5 class="card-title mb-3">Scan this QR code</h5>
              <img src="@ViewBag.QrDataUrl" alt="QR Code" class="img-fluid" style="max-width: 260px;" />
              <p class="text-muted mt-3 mb-0">
                Can't scan? Enter this key manually in your app:
                <br /><strong>@ViewBag.KeyFormatted</strong>
              </p>
              <p class="small text-muted mt-2">Issuer: CondoSphere</p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title mb-3">Verify a code</h5>
              <p class="text-muted">After adding the account in your authenticator, type a 6-digit code to enable 2FA.</p>

              <form asp-action="EnableTwoFactor" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                  <label class="form-label" for="code">Code</label>
                  <input id="code" name="code" class="form-control" autocomplete="one-time-code" placeholder="123 456" />
                </div>
                <button class="btn btn-primary">Enable 2FA</button>
              </form>
            </div>
          </div>
        </div>
      </div>
  }
</div>
