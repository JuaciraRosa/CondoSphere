@model IEnumerable<string>
@{
    ViewData["Title"] = "Códigos de recuperação";
    Layout = "_Layout";
}
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-body">
          <h3 class="mb-3">Guarda estes códigos em local seguro</h3>
          <p class="text-muted">
            Cada código pode ser usado <strong>uma única vez</strong> para entrar sem o app autenticador.
            Gerar novos códigos invalida os anteriores.
          </p>

          <ul class="list-group mb-3">
            @foreach (var c in Model)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <code class="fs-5">@c</code>
                    <span class="badge bg-secondary">uso único</span>
                </li>
            }
          </ul>

          <div class="d-flex gap-2">
            <a asp-action="TwoFactor" class="btn btn-primary">Concluir</a>
            <form asp-action="GenerateRecoveryCodes" method="post" class="ms-auto">
              @Html.AntiForgeryToken()
              <button class="btn btn-outline-secondary">Gerar novos códigos</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
