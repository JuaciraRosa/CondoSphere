﻿@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    var user = HttpContextAccessor.HttpContext?.User;
    var isAuth = user?.Identity?.IsAuthenticated == true;
    var role = user?.FindFirst(ClaimTypes.Role)?.Value
               ?? user?.FindFirst("role")?.Value;

   var anti = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CondoSphere</title>

    <!-- Favicons -->
    <link rel="icon" href="~/assets/img/favicon.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/assets/img/apple-touch-icon.png" asp-append-version="true" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Nunito:wght@400;600;700&family=Raleway:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Vendor CSS -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" asp-append-version="true" />

    <!-- Main CSS -->
    <link href="~/assets/css/main.css" rel="stylesheet" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>
<body class="index-page">

    <!-- Header -->
    <header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container position-relative d-flex align-items-center justify-content-between">
  <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto me-lg-0 text-decoration-none">
    <h1 class="sitename m-0">CondoSphere</h1>
  </a>

<nav id="navmenu" class="navmenu">
  <ul>
    @if (isAuth)
    {
      <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>

      @* Administrator *@
      @if (role == "Administrator")
      {
        <li><a asp-controller="Users" asp-action="Index">Users</a></li>
        <li><a asp-controller="Companies" asp-action="Index">Companies</a></li>
      }

      @* Administrator or Manager *@
      @if (role == "Administrator" || role == "Manager")
      {
        <li><a asp-controller="Condominiums" asp-action="Index">Condominiums</a></li>
        <li><a asp-controller="Units" asp-action="Create">Create Unit</a></li>
        <li><a asp-controller="Meetings" asp-action="Index">Meetings</a></li>
        <li><a asp-controller="Expenses" asp-action="Index">Expenses</a></li>
        <li><a asp-controller="Quotas" asp-action="Index">Quotas</a></li>
        <li><a asp-controller="Payments" asp-action="Index">Payments</a></li>

        @* Sem badge para Admin/Manager *@
        <li><a asp-controller="Announcements" asp-action="Index">Announcements</a></li>

        <li><a asp-controller="Occurrences" asp-action="Index">Occurrences</a></li>
        <li><a asp-controller="PollsAdmin" asp-action="Index">Polls</a></li>
        <li><a asp-controller="Reports" asp-action="Index">Reports</a></li>
        <li><a asp-controller="MaintenanceRequests" asp-action="Index">Maintenance Requests</a></li>
     <li class="nav-item">
    <a class="nav-link position-relative" asp-controller="Chat" asp-action="Index">
      Chat
      @await Component.InvokeAsync("NewChatBadge", new { days = 3 })
    </a>
  </li>

      }

      @* Resident *@
      @if (role == "Resident")
      {
        <li><a asp-controller="Units" asp-action="Index">My Unit</a></li>
        <li><a asp-controller="Meetings" asp-action="Index">Meetings</a></li>
        <li>
          <a asp-controller="Announcements" asp-action="Index">
            Announcements @await Component.InvokeAsync("NewAnnouncementsBadge", new { days = 3 })
          </a>
        </li>
        <li><a asp-controller="Occurrences" asp-action="Index">Occurrences</a></li>
        <li><a asp-controller="Polls" asp-action="Index">Voting</a></li>
        <li><a asp-controller="MaintenanceRequests" asp-action="Index">Maintenance Requests</a></li>
      }

      @* Account dropdown *@
      <li class="dropdown">
        <a href="#"><span>@($"{user?.Identity?.Name} ({role})")</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
        <ul>
          <li><a asp-controller="Account" asp-action="Profile">Profile</a></li>
          <li><a asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
          <li><a asp-controller="Account" asp-action="DownloadData">Download My Data (JSON)</a></li>
          <li>
            <form asp-controller="Account" asp-action="Deactivate" method="post" style="display:inline;">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-link text-danger">Deactivate Account</button>
            </form>
          </li>
        </ul>
      </li>
    }
  </ul>
  <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
</nav>

  <div class="d-flex align-items-center gap-2">
    @if (isAuth)
    {
      <form method="post" asp-controller="Auth" asp-action="Logout" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
      </form>
    }
    else
    {
      <a class="btn btn-primary btn-sm" href="@Url.Action("Login","Auth")">Login</a>
    }
  </div>
</div>


       

        </div>
    </header>

    @* Page title/breadcrumbs opcional *@
    @RenderSection("PageHeader", required: false)

    <main class="py-4">
        <div class="container" data-aos="fade-up">
            @if (TempData["Success"] is string ok && !string.IsNullOrEmpty(ok))
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["Error"] is string err && !string.IsNullOrEmpty(err))
            {
                <div class="alert alert-danger">@err</div>
            }

            @RenderBody()
        </div>
    </main>

    <footer id="footer" class="footer">
        <div class="container d-flex justify-content-between small">
            <span>&copy; @DateTime.UtcNow.Year - CondoSphere</span>
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
        </div>
    </footer>

    <!-- Scroll Top & Preloader -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center">
        <i class="bi bi-arrow-up-short"></i>
    </a>
    <div id="preloader"></div>

    <!-- Vendor JS -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/php-email-form/validate.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/aos/aos.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/waypoints/noframework.waypoints.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js" asp-append-version="true"></script>

    <!-- Main JS -->
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
@if (isAuth && string.Equals(role, "Resident", StringComparison.OrdinalIgnoreCase))
{
  <style>
    /* botão flutuante */
    #botToggle{position:fixed;right:22px;bottom:22px;width:56px;height:56px;border:none;border-radius:50%;
      background:#3076ff;color:#fff;display:grid;place-items:center;box-shadow:0 8px 24px rgba(0,0,0,.18);z-index:1100}
    #botToggle i{font-size:22px}
    /* painel */
    #botPanel{position:fixed;right:22px;bottom:90px;width:min(370px,92vw);max-height:min(68vh,640px);background:#fff;border-radius:12px;
      box-shadow:0 18px 40px rgba(0,0,0,.22);display:none;flex-direction:column;overflow:hidden;z-index:1100}
    #botPanel.show{display:flex}
    #botHead{padding:10px 12px;background:#f7f9ff;border-bottom:1px solid #e9eefc}
    #botClose{border:0;background:transparent;color:#666}
    #botMsgs{padding:14px;overflow-y:auto;min-height:160px}
    #botInputRow{padding:10px;border-top:1px solid #eee;display:grid;grid-template-columns:1fr auto;gap:8px}
    #botSend{width:44px;border-radius:10px}
  </style>

  <!-- BOT: botão + painel -->
  <button id="botToggle" title="Assistente"><i class="bi bi-chat-dots"></i></button>

  <div id="botPanel" role="dialog" aria-label="Assistente">
    <div id="botHead" class="d-flex align-items-center justify-content-between">
      <strong>Assistente</strong>
      <button id="botClose" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div id="botMsgs" class="small"><div class="text-muted">Conectando…</div></div>
    <div id="botInputRow">
      <input id="botInput" class="form-control" placeholder="Escreva sua mensagem…" />
      <button id="botSend" class="btn btn-primary"><i class="bi bi-send"></i></button>
    </div>
  </div>
<script>
(function () {
  const ORIGIN    = window.location.origin;
  const START_API = `${ORIGIN}/Chat/StartApi`;
  const POLL_URL  = (id, after) => `${ORIGIN}/Chat/Poll?id=${id}&after=${after}`;
  const SEND_API  = `${ORIGIN}/Chat/SendApi`;
  const anti      = '@anti'; // já gerado no topo do _Layout

  // elementos
  const toggle = document.getElementById('botToggle');
  const panel  = document.getElementById('botPanel');
  const close  = document.getElementById('botClose');
  const msgs   = document.getElementById('botMsgs');
  const input  = document.getElementById('botInput');
  const send   = document.getElementById('botSend');

  let threadId = null;
  let lastId   = 0;                // maior ID já visto
  let timer    = null;
  let ready    = false;            // só habilita envio após carregar histórico
  const seen   = new Set();        // proteção extra anti-duplicado

  function setEnabled(enabled){
    input.disabled = !enabled;
    send.disabled  = !enabled;
  }

  function append(role, text, when){
    const wrap = document.createElement('div');
    wrap.className = 'mb-2';
    const dt = when ? (' · ' + new Date(when).toLocaleString()) : '';
    wrap.innerHTML = `<div class="text-muted"><strong>${role}</strong>${dt}</div><div>${text}</div>`;
    msgs.appendChild(wrap);
    msgs.scrollTop = msgs.scrollHeight;
  }

  async function ensureThread(){
    if (threadId) return threadId;
    const res = await fetch(START_API, {
      method: 'POST',
      headers: { 'RequestVerificationToken': anti },
      credentials: 'include'
    });
    if (!res.ok) { append('Erro', 'Falha ao iniciar a conversa.'); throw new Error('StartApi '+res.status); }
    const j = await res.json();
    if (!j.ok) throw new Error('payload');
    threadId = j.id;
    return threadId;
  }

  async function pollOnce(){
    if (!threadId) return;
    const res = await fetch(POLL_URL(threadId, lastId), { credentials: 'include' });
    if (!res.ok) return;
    const items = await res.json();
    for (const m of items){
      // servidor retorna "id" (minúsculo)
      if (seen.has(m.id)) continue;         // já renderizada
      append(m.role, m.text, m.createdAt);
      seen.add(m.id);
      if (m.id > lastId) lastId = m.id;     // avança o ponteiro
    }
  }

  function startPolling(){
    if (timer) clearInterval(timer);
    timer = setInterval(pollOnce, 3500);
  }
  function stopPolling(){
    if (timer) { clearInterval(timer); timer = null; }
  }

  async function openPanel(){
    msgs.innerHTML = '<div class="text-muted">Conectando…</div>';
    setEnabled(false);
    ready = false;
    try{
      await ensureThread();
      // carrega histórico completo (after=0) e define lastId corretamente
      const r = await fetch(POLL_URL(threadId, 0), { credentials: 'include' });
      msgs.innerHTML = '';
      seen.clear();
      lastId = 0;

      if (r.ok){
        const items = await r.json();
        for (const m of items){
          append(m.role, m.text, m.createdAt);
          seen.add(m.id);
          if (m.id > lastId) lastId = m.id;
        }
      }
      ready = true;
      setEnabled(true);
      startPolling();
    } catch(e){
      console.error(e);
      msgs.innerHTML = '<div class="text-danger">Conexão indisponível.</div>';
    }
  }

  async function sendMsg(){
    if (!ready) return;                       // evita enviar antes do histórico
    const t = (input.value || '').trim();
    if (!t) return;

    try{
      await ensureThread();
      const r = await fetch(SEND_API, {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'RequestVerificationToken': anti
        },
        body: new URLSearchParams({ id: threadId, text: t })
      });
      if (!r.ok) throw new Error('SendApi ' + r.status);

      // 👇 usa o retorno do servidor para avançar o ponteiro
      const j = await r.json();               // { ok, id, when }
      append('Resident', t, j.when);          // eco local com timestamp real
      if (j?.id){
        seen.add(j.id);                       // marca como já renderizada
        lastId = Math.max(lastId, j.id);      // <- chave para não duplicar no próximo poll
      }

      input.value = '';
      input.focus();

      // puxa respostas (ex.: bot) logo em seguida
      setTimeout(pollOnce, 400);
    } catch(e){
      console.error(e);
      append('Erro', 'Não foi possível enviar agora.');
    }
  }

  // UI
  toggle?.addEventListener('click', () => {
    panel.classList.toggle('show');
    if (panel.classList.contains('show')) openPanel(); else stopPolling();
  });
  close?.addEventListener('click', () => { panel.classList.remove('show'); stopPolling(); });
  send?.addEventListener('click', sendMsg);
  input?.addEventListener('keydown', ev => { if (ev.key === 'Enter') { ev.preventDefault(); sendMsg(); } });
})();
</script>

}



    @RenderSection("Scripts", required: false)
  </body>
</html>

