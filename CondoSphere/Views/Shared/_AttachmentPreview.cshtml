@model string
@* attachment path (ex.: "/uploads/ann/xxx.pdf") *@

@{
    var path = Model;
    if (string.IsNullOrWhiteSpace(path)) { return; }

    var ext = System.IO.Path.GetExtension(path).ToLowerInvariant();
    bool isPdf = ext == ".pdf";
    bool isImg = ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp";
}

@if (isPdf)
{
    <div class="mt-3">
        <iframe src="@Url.Content(path)"
                style="width:100%;height:70vh;border:1px solid #eee;border-radius:8px"></iframe>
    </div>
}
else if (isImg)
{
    <div class="mt-3">
        <img src="@Url.Content(path)" alt="Attachment" class="img-fluid rounded border" />
    </div>
}
