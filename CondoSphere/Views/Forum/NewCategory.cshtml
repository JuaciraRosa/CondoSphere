@{
    ViewData["Title"] = "New category";
}
<div class="container-xl">
  <div class="card card-body">
    <form asp-action="NewCategory" method="post">
      @Html.AntiForgeryToken()
      <div class="mb-2">
        <label class="form-label">Name</label>
        <input name="name" class="form-control" required maxlength="80" />
      </div>
      <div class="mb-2">
        <label class="form-label">Sort order</label>
        <input name="sortOrder" type="number" class="form-control" value="1" />
      </div>
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="isLocked" id="isLocked">
        <label class="form-check-label" for="isLocked">Locked</label>
      </div>
      <div class="text-end">
        <button class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
      </div>
    </form>
  </div>
</div>
