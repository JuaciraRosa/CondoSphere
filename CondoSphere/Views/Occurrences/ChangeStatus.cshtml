@model CondoSphere.Features.Ocurrences.OccurrenceDto
@{
    ViewData["Title"] = "Alterar Estado da Ocorrência";
    var statuses = new[] { "Open", "InProgress", "Resolved", "Rejected" };
}

<h2>@ViewData["Title"]</h2>

<div class="card p-3">
    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Criada em</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

        <dt class="col-sm-3">Estado atual</dt>
        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Status</span></dd>
    </dl>

    <form asp-action="ChangeStatus" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-3">
            <label for="status" class="form-label">Novo estado</label>
            <select class="form-select" id="status" name="status" required>
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(s == Model.Status ? "selected" : null)">@s</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" asp-route-condominiumId="@Model.CondominiumId" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>
