@model IEnumerable<CondoSphere.Features.Ocurrences.OccurrenceDto>
@using System.Security.Claims
@{
    ViewData["Title"] = "Ocorrências";
    var map = ViewBag.CondoLookup as Dictionary<int, (string Condo, string Company)>;
    int? currentCondoId = ViewBag.CurrentCondoId as int?;


       // garante o autor
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("role")?.Value;
    var isStaff = string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase)
               || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Ocorrências</h2>
    <a asp-action="Create"
       asp-route-condominiumId="@currentCondoId"
       class="btn btn-primary">Nova ocorrência</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Condomínio</th>
            <th>Unidade</th>
            <th>Título</th>
            <th>Estado</th>
            <th>Criada em</th>
            <th style="width:1%"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var o in Model)
    {
        var display = o.CondominiumId.ToString();
        if (map != null && map.TryGetValue(o.CondominiumId, out var info))
            display = $"{info.Condo} ({info.Company})";
        <tr>
            <td>@display</td>
            <td>@o.UnitNumber</td>
            <td>@o.Title</td>
            <td>
                @switch (o.Status)
                {
                    case "Open":
                        @:<span class="badge bg-secondary">Open</span>
                        break;
                    case "InProgress":
                        @:<span class="badge bg-warning text-dark">Em progresso</span>
                        break;
                    case "Resolved":
                        @:<span class="badge bg-success">Resolvida</span>
                        break;
                    default:
                        @o.Status
                        break;
                }
            </td>
            <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-nowrap">

                  @if (isStaff)
                {
                    <a asp-action="Details" asp-route-id="@o.Id"
                       class="btn btn-sm btn-outline-primary me-1">Details</a>

                    <form asp-action="ChangeStatus" method="post" class="d-inline me-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@o.Id" />
                        <button class="btn btn-sm btn-outline-warning" name="status" value="InProgress">Em progresso</button>
                        <button class="btn btn-sm btn-outline-success" name="status" value="Resolved">Resolver</button>
                    </form>

                    <form asp-action="Delete"
                          asp-route-condominiumId="@o.CondominiumId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Apagar esta ocorrência?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@o.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="fa fa-trash"></i> Apagar
                        </button>
                    </form>
                }
                else
                {
                    <a asp-action="Details" asp-route-id="@o.Id"
                       class="btn btn-sm btn-outline-primary">Details</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
