@model CondoSphere.Features.Ocurrences.OccurrenceDto
@{
    ViewData["Title"] = "Nova Ocorrência";
    var condoId = ViewBag.CondoId as int?;
}
<h2>Nova Ocorrência</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
   <div class="mb-3">
        <label class="form-label">Condomínio</label>
        <select asp-for="CondominiumId" class="form-select" asp-items="ViewBag.CondominiumId"></select>
        <span asp-validation-for="CondominiumId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Unidade</label>
        <input asp-for="UnitNumber" class="form-control" placeholder="A1" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Título</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Descrição</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="CreatedBy" class="form-control" required />
    </div>
    <button class="btn btn-primary">Criar</button>
</form>

