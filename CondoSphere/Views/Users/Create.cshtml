@model CondoSphere.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<section class="section">
    <div class="container">
        <div class="card p-4 shadow-sm">
            <h4 class="mb-4"><i class="bi bi-plus-circle"></i> Create User</h4>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
        <label class="form-label">Company</label>
        <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
            <option value="">-- select --</option>
        </select>
        <span asp-validation-for="CompanyId" class="text-danger"></span>
    </div>
                     <div class="col-md-6">
    <label class="form-label">Password</label>
    <div class="input-group">
      <input asp-for="Password" type="password" class="form-control" id="pwdInput" />
      <button type="button" class="btn btn-outline-secondary" id="togglePwd" tabindex="-1">
        <i class="bi bi-eye"></i>
      </button>
    </div>
    <span asp-validation-for="Password" class="text-danger"></span>
  </div>

  <div class="col-md-6">
    <label class="form-label">Confirm Password</label>
    <div class="input-group">
      <input asp-for="ConfirmPassword" type="password" class="form-control" id="pwd2Input" />
      <button type="button" class="btn btn-outline-secondary" id="togglePwd2" tabindex="-1">
        <i class="bi bi-eye"></i>
      </button>
    </div>
    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
  </div>
                    <div class="col-md-3">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select"
                                asp-items="Html.GetEnumSelectList<UserRole>()"></select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" disabled />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-primary"><i class="bi bi-check2"></i> Save</button>
                    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
                </div>

             

            </form>
        </div>
    </div>
</section>

@section Scripts{
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
  <script>
    (function(){
      function wire(btnId, inputId){
        const btn = document.getElementById(btnId);
        const input = document.getElementById(inputId);
        if(!btn || !input) return;
        btn.addEventListener('click', () => {
          const isPwd = input.type === 'password';
          input.type = isPwd ? 'text' : 'password';
          const icon = btn.querySelector('i');
          if(icon){
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
          }
        });
      }
      wire('togglePwd',  'pwdInput');
      wire('togglePwd2', 'pwd2Input');
    })();
  </script>
}