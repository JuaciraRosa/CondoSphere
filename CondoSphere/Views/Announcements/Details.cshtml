@model CondoSphere.Models.Announcement
@{
    ViewData["Title"] = Model.Title;
    bool isAdmin = User.IsInRole("Administrator") || User.IsInRole("Manager");
}

<div class="container">
  <div class="card p-3">
    <h4>@Model.Title</h4>
    <div class="text-muted small mb-2">@Model.CreatedAt.ToLocalTime()</div>

    <div class="mb-3">@Html.Raw(Model.Body)</div>

    @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
    {
        <div class="mt-3">
            <!-- Download -->
            <a class="btn btn-sm btn-outline-primary"
               asp-action="Download"
               asp-route-id="@Model.Id"
               target="_blank" rel="noopener">
               <i class="bi bi-download"></i> Download attachment
            </a>

            <!-- Preview inline (PDF/Imagens) -->
            <partial name="~/Views/Shared/_AttachmentPreview.cshtml"
                     model="Model.AttachmentPath" />
        </div>
    }
    else
    {
        <div class="alert alert-secondary">No attachment included for this announcement.</div>
    }

    <div class="mt-3">
      <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
      @if (isAdmin)
      {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Edit</a>
        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete?');">
          @Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@Model.Id" />
          <button class="btn btn-sm btn-danger">Delete</button>
        </form>
      }
    </div>
  </div>
</div>
