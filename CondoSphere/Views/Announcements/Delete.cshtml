@model CondoSphere.Models.Announcement
@{
    ViewData["Title"] = "Delete Announcement";
}

<div class="container-xl">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h3 class="card-title"><i class="ti ti-trash"></i> Delete Announcement</h3>
        </div>

        <div class="card-body">
            <h5 class="mb-3">Are you sure you want to delete this announcement?</h5>

            <dl class="row mt-2">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Condominium</dt>
                <dd class="col-sm-9">@Model.Condominium?.Name ?? "Global"</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime()</dd>

                <dt class="col-sm-3">Body</dt>
                <dd class="col-sm-9">
                    <div class="border rounded p-2 bg-light" style="white-space:pre-wrap">@Model.Body</div>
                </dd>

                @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
                {
                    <dt class="col-sm-3">Attachment</dt>
                    <dd class="col-sm-9">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Download" asp-route-id="@Model.Id" target="_blank" rel="noopener">
                                <i class="bi bi-download"></i> Download
                            </a>
                            <span class="text-muted small">@System.IO.Path.GetFileName(Model.AttachmentPath)</span>
                        </div>

                        <!-- Preview inline (PDF/Imagens) -->
                        <partial name="~/Views/Shared/_AttachmentPreview.cshtml"
                                 model="Model.AttachmentPath" />
                    </dd>
                }
            </dl>
        </div>

        <div class="card-footer">
            <form asp-action="Delete" method="post" class="mt-2 d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
