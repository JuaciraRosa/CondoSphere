@model CondoSphere.Models.Announcement
@{
    var isEdit = Model?.Id > 0;
}
<div asp-validation-summary="All" class="text-danger mb-2"></div>

@if (isEdit)
{
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AttachmentPath" />
}

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Body" class="form-label"></label>
    <textarea asp-for="Body" class="form-control" rows="6"></textarea>
    <span asp-validation-for="Body" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CondominiumId" class="form-label">Condominium</label>
    <select asp-for="CondominiumId" class="form-select" asp-items="ViewBag.CondominiumId"></select>
    <span asp-validation-for="CondominiumId" class="text-danger"></span>
</div>

@if (!string.IsNullOrWhiteSpace(Model?.AttachmentPath) && isEdit)
{
    <div class="mb-2 d-flex align-items-center gap-2">
        <span class="text-muted">Current attachment:</span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Download" asp-route-id="@Model!.Id">
            <i class="bi bi-download"></i> Download
        </a>
    </div>

    @* Preview inline (PDF/Imagem) *@
    <partial name="~/Views/Shared/_AttachmentPreview.cshtml" model="Model.AttachmentPath" />
}

<div class="mb-3">
    <label class="form-label">New attachment (optional)</label>
    <input type="file" name="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.doc,.docx" />
    <span class="form-text">Até 5 MB (ajuste a validação conforme necessário).</span>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="form-check">
            <input asp-for="SendEmail" class="form-check-input" />
            <label asp-for="SendEmail" class="form-check-label">Send by email</label>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-check">
            <input asp-for="SendInApp" class="form-check-input" />
            <label asp-for="SendInApp" class="form-check-label">Show in app</label>
        </div>
    </div>
</div>

<div class="mb-3 mt-2">
    <label asp-for="ScheduledAtUtc" class="form-label">Schedule (UTC, optional)</label>
    <input asp-for="ScheduledAtUtc" class="form-control" />
    <span asp-validation-for="ScheduledAtUtc" class="text-danger"></span>
</div>
