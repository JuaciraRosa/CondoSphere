@model CondoSphere.Models.ChatThread
@using CondoSphere.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = $"Chat #{Model.Id} — {Model.Subject}";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    string badge = Model.Status == "Open" ? "bg-success" : "bg-secondary";
    var __af = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // Só pode enviar quando o tópico está Open (vale para qualquer papel)
    var canSend = string.Equals(Model.Status, "Open", StringComparison.OrdinalIgnoreCase);

    var myRoleLabel = isAdmin ? "Admin" : "Resident";
}

<section class="section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
      <h3 class="m-0">@ViewData["Title"]</h3>

      <!-- sem upload aqui; upload fica só no widget do morador -->
      <a asp-action="Index" class="btn btn-outline-primary mt-2">Voltar</a>
    </div>

    <div class="row">
      <div class="col-lg-8">
        <div id="msgs" class="card p-3" style="min-height:380px;max-height:60vh;overflow:auto">
          @foreach (var m in Model.Messages.OrderBy(m => m.CreatedAt))
          {
            <div class="mb-3" data-mid="@m.Id">
              <div class="small text-muted d-flex align-items-center gap-2">
                <strong>@(m.Role == ChatRole.Admin ? "Admin" : m.Role.ToString())</strong>
                <span>· @m.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>

                @* remover se não quiser permitir delete *@
                @if (isAdmin)
                {
                  <form asp-action="DeleteMessage" method="post" class="ms-auto"
                        onsubmit="return confirm('Apagar esta mensagem?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@m.Id" />
                    <button class="btn btn-link btn-sm text-danger p-0">
                      <i class="bi bi-x-circle"></i> apagar
                    </button>
                  </form>
                }
              </div>

              <div>@m.Text</div>

              @if (m.Attachments?.Any() == true)
              {
                foreach (var a in m.Attachments)
                {
                  <div><a href="@a.StoragePath" target="_blank" rel="noopener">@a.FileName</a></div>
                }
              }
            </div>
          }
        </div>

        <div class="input-group mt-3">
          <input id="msg" class="form-control"
                 placeholder="@(canSend ? "Escreva sua mensagem…" : "Tópico fechado")"
                 autocomplete="off" @(canSend ? null : "disabled") />
          <button id="sendBtn" type="button" class="btn btn-primary" @(canSend ? null : "disabled")>
            <i class="bi bi-send"></i>
          </button>
        </div>
        <small class="text-muted">
          @(canSend ? "Pressione Enter para enviar." : "Tópico encerrado. Reabra para continuar.")
        </small>
      </div>

      <div class="col-lg-4">
        <div class="card p-3">
          <div class="d-flex justify-content-between">
            <div>
              <div class="small text-muted">Estado</div>
              <span id="statusBadge" class="badge @badge">@Model.Status</span>
            </div>
            <div class="text-end">
              <div class="small text-muted">Criado</div>
              <div>@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
            </div>
          </div>

          <div class="mt-3 small text-muted">
            Última atividade<br />
            <span id="lastAt">@Model.LastActivityAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
          </div>

          @if (isAdmin)
          {
            <div class="mt-3 d-flex flex-wrap gap-2">
              @if (Model.Status == "Open")
              {
                <form asp-action="Close" method="post" onsubmit="return confirm('Fechar este tópico?');">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@Model.Id" />
                  <button class="btn btn-outline-warning btn-sm"><i class="bi bi-lock"></i> Fechar</button>
                </form>
              }
              else
              {
                <form asp-action="Reopen" method="post">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@Model.Id" />
                  <button class="btn btn-outline-success btn-sm"><i class="bi bi-unlock"></i> Reabrir</button>
                </form>
              }

              <form asp-action="DeleteThread" method="post" class="ms-auto"
                    onsubmit="return confirm('Apagar a conversa inteira? Esta ação não pode ser desfeita.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Apagar</button>
              </form>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</section>

<input type="hidden" id="threadId" value="@Model.Id" />
<input type="hidden" id="__af" value="@__af" />
<input type="hidden" id="roleLabel" value="@myRoleLabel" />

<script>
(function () {
  const ORIGIN   = window.location.origin;
  const POLL_URL = (id, after) => `${ORIGIN}/Chat/Poll?id=${id}&after=${after}`;
  const SEND_API = `${ORIGIN}/Chat/SendApi`;
  const anti     = document.getElementById('__af').value;

  const threadId = parseInt(document.getElementById('threadId').value, 10);
  const list     = document.getElementById('msgs');
  const input    = document.getElementById('msg');
  const btn      = document.getElementById('sendBtn');
  const roleLbl  = document.getElementById('roleLabel').value;

  const CAN_SEND = @((string.Equals(Model.Status, "Open", StringComparison.OrdinalIgnoreCase)).ToString().ToLower());

  let lastId = 0;

  function hasMsg(id) {
    return !!list.querySelector(`[data-mid="${id}"]`);
  }

  function append(role, text, when, id) {
    // evita duplicar se por algum motivo já existir
    if (id && hasMsg(id)) return;

    const wrap = document.createElement('div');
    wrap.className = 'mb-3';
    if (id) wrap.setAttribute('data-mid', id);
    wrap.innerHTML =
      `<div class="small text-muted"><strong>${role}</strong> · ${when}</div><div>${text}</div>`;
    list.appendChild(wrap);
    list.scrollTop = list.scrollHeight;
  }

  function getInitialLastId() {
    let mx = 0;
    list.querySelectorAll('[data-mid]').forEach(n => {
      const id = parseInt(n.getAttribute('data-mid'), 10) || 0;
      if (id > mx) mx = id;
    });
    return mx;
  }

  async function pollOnce() {
    try {
      const res = await fetch(POLL_URL(threadId, lastId), { credentials: 'include' });
      if (!res.ok) return;
      const items = await res.json();
      for (const m of items) {
        if (hasMsg(m.id)) continue; // guarda-costas
        append(m.role, m.text, new Date(m.createdAt).toLocaleString(), m.id);
        if (m.id > lastId) lastId = m.id;
      }
    } catch {}
  }

  async function send() {
    if (!CAN_SEND) return;
    const t = (input.value || '').trim();
    if (!t) return;

    try {
      const r = await fetch(SEND_API, {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'RequestVerificationToken': anti
        },
        body: new URLSearchParams({ id: threadId, text: t })
      });
      if (!r.ok) throw new Error('SendApi ' + r.status);

      // usa o retorno para ajustar lastId e carimbar data-mid
      const j = await r.json(); // { ok:true, id, when }
      const when = new Date(j.when).toLocaleString();

      // pinta localmente com o id do servidor
      append(roleLbl, t, when, j.id);

      // IMPORTANTÍSSIMO: avança o ponteiro para não duplicar no próximo poll
      if (j.id && j.id > lastId) lastId = j.id;

      input.value = '';
      input.focus();

      // busca respostas do bot / do outro lado sem repetir a minha msg
      setTimeout(pollOnce, 200);
    } catch (e) {
      console.error(e);
      append('Erro', 'Não foi possível enviar. Tente novamente.', new Date().toLocaleString());
    }
  }

  lastId = getInitialLastId();
  setInterval(pollOnce, 3000);

  btn.addEventListener('click', send);
  input.addEventListener('keydown', ev => { if (ev.key === 'Enter') { ev.preventDefault(); send(); } });
})();
</script>
