@model IEnumerable<CondoSphere.Models.ChatThread>

@{
    ViewData["Title"] = "Chat";
    var isAdmin = (bool)ViewBag.IsAdmin;
    string q = ViewBag.Q as string ?? "";
    var status  = ViewBag.FilterStatus as string; // "", "Open", "Closed"
}

<section class="section">
  <div class="container">

    <div class="d-flex align-items-center justify-content-between mb-3">
      <h3 class="m-0">Chat</h3>
    </div>

    <div class="d-flex gap-2 align-items-center mb-3">
     <form method="get" class="d-flex gap-2 mb-3">
  <input class="form-control" name="q" value="@q" placeholder="Buscar por assunto ou mensagens…" />
  <select class="form-select" name="status" style="max-width:160px">
    <option value="">Todos</option>
    <option value="Open" selected="@(ViewBag.FilterStatus=="Open")">Abertos</option>
    <option value="Closed" selected="@(ViewBag.FilterStatus=="Closed")">Fechados</option>
  </select>
  <button class="btn btn-outline-secondary">Filtrar</button>
</form>

      @* Morador pode abrir novo tópico *@
      @if (!isAdmin)
      {
        <form asp-action="Start" method="post" class="ms-auto">
          @Html.AntiForgeryToken()
          <input type="hidden" name="subject" value="Suporte" />
          <button class="btn btn-sm btn-primary">
            <i class="bi bi-chat-dots"></i> Novo tópico
          </button>
        </form>
      }
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width:70px;">#</th>
                <th>Assunto</th>
                <th style="width:110px;">Estado</th>
                <th style="width:220px;">Criado</th>
                <th style="width:220px;">Última atividade</th>
                <th style="width:120px;"></th>
              </tr>
            </thead>
          <tbody>
@foreach (var t in Model ?? Enumerable.Empty<CondoSphere.Models.ChatThread>())
{
  <tr data-thread="@t.Id">
    <td>@t.Id</td>
    <td>@t.Subject</td>
    <td>
      <span class="badge @(t.Status=="Open"?"bg-success":"bg-secondary")">@t.Status</span>
    </td>
    <td>@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
    <td>
      <div data-last>@(t.LastPreview ?? "")</div>
      <small class="text-muted" data-lastat>@t.LastActivityAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
    </td>
    <td class="text-end">
      @if (isAdmin && t.UnreadForAdmin > 0)
      { <span data-unread class="badge rounded-pill text-bg-danger">@t.UnreadForAdmin</span> }
      else if (!isAdmin && t.UnreadForResident > 0)
      { <span data-unread class="badge rounded-pill text-bg-primary">@t.UnreadForResident</span> }
      <a asp-action="Thread" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary ms-2">Abrir</a>
    </td>
  </tr>
}
@if (!(Model?.Any() ?? false))
{
  <tr><td colspan="6" class="text-center text-muted py-4">Sem tópicos.</td></tr>
}
</tbody>

          </table>
        </div>
      </div>
    </div>

  </div>
</section>

      <script src="https://cdn.jsdelivr.net/npm/%40microsoft/signalr@8.0.5/dist/browser/signalr.min.js"></script>
<script>
(function(){
  const isAdmin = @((bool)ViewBag.IsAdmin ? "true" : "false");
  if(!isAdmin) return;

  const hub = new signalR.HubConnectionBuilder()
    .withUrl('/hubs/chat', { transport: signalR.HttpTransportType.LongPolling, withCredentials: true })
    .withAutomaticReconnect()
    .build();

  hub.on('ThreadUpdated', t => {
    const row = document.querySelector(`[data-thread="${t.id}"]`);
    if (row) {
      row.querySelector('[data-last]')?.replaceChildren(document.createTextNode(t.last ?? ''));
      row.querySelector('[data-lastat]')?.replaceChildren(document.createTextNode(t.lastAt ?? ''));
      const ub = row.querySelector('[data-unread]');
      if (ub) ub.textContent = (t.unread && t.unread > 0) ? t.unread : '';
      else if (t.unread && t.unread > 0) {
        const span = document.createElement('span');
        span.className = 'badge rounded-pill text-bg-danger';
        span.setAttribute('data-unread','');
        span.textContent = t.unread;
        row.children[row.children.length-2].appendChild(span);
      }
    } else {
      // opcional: inserir nova linha no topo
      // (para simplificar, recarregue a página se quiser)
    }
  });

  hub.start().catch(console.error);
})();
</script>
