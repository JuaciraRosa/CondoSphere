@model IEnumerable<CondoSphere.Models.ChatThread>

@{
    ViewData["Title"] = "Chat";
    var isAdmin = (bool)ViewBag.IsAdmin;
    string q = ViewBag.Q as string ?? "";
}

<section class="section">
  <div class="container">

    <div class="d-flex align-items-center justify-content-between mb-3">
      <h3 class="m-0">Chat</h3>
    </div>

    <div class="d-flex gap-2 align-items-center mb-3">
      <form method="get" class="d-flex gap-2 mb-3">
        <input class="form-control" name="q" value="@q" placeholder="Buscar por assunto ou mensagens…" />
        <select class="form-select" name="status" style="max-width:160px">
          <option value="">Todos</option>
          <option value="Open" selected="@(ViewBag.FilterStatus=="Open")">Abertos</option>
          <option value="Closed" selected="@(ViewBag.FilterStatus=="Closed")">Fechados</option>
        </select>
        <button class="btn btn-outline-secondary">Filtrar</button>
      </form>

      @if (!isAdmin)
      {
        <form asp-action="Start" method="post" class="ms-auto">
          @Html.AntiForgeryToken()
          <input type="hidden" name="subject" value="Suporte" />
          <button class="btn btn-sm btn-primary"><i class="bi bi-chat-dots"></i> Novo tópico</button>
        </form>
      }
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width:70px;">#</th>
                <th>Assunto</th>
                <th style="width:110px;">Estado</th>
                <th style="width:220px;">Criado</th>
                <th style="width:220px;">Última atividade</th>
                <th style="width:120px;"></th>
              </tr>
            </thead>
            <tbody id="threadRows">
@foreach (var t in Model ?? Enumerable.Empty<CondoSphere.Models.ChatThread>())
{
  <tr data-thread="@t.Id">
    <td>@t.Id</td>
    <td>@t.Subject</td>
    <td><span class="badge @(t.Status=="Open"?"bg-success":"bg-secondary")">@t.Status</span></td>
    <td>@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
    <td>
      <div data-last>@(t.LastPreview ?? "")</div>
      <small class="text-muted" data-lastat>@t.LastActivityAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
    </td>
    <td class="text-end">
      @if (isAdmin && t.UnreadForAdmin > 0)
      { <span data-unread class="badge rounded-pill text-bg-danger">@t.UnreadForAdmin</span> }
      else if (!isAdmin && t.UnreadForResident > 0)
      { <span data-unread class="badge rounded-pill text-bg-primary">@t.UnreadForResident</span> }
      <a asp-action="Thread" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary ms-2">Abrir</a>
    </td>
  </tr>
}
@if (!(Model?.Any() ?? false))
{
  <tr><td colspan="6" class="text-center text-muted py-4">Sem tópicos.</td></tr>
}
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</section>

@if (isAdmin)
{
<script>
(function(){
  const ORIGIN = window.location.origin;
  const API    = (ticks) => `${ORIGIN}/Chat/AdminPoll${ticks?`?afterTicks=${ticks}`:""}`;

  let lastTicks = null;

  function upsertRow(item){
    const rows = document.getElementById('threadRows');
    let row = rows.querySelector(`[data-thread="${item.id}"]`);
    if(!row) return; // para manter simples, só atualiza linhas existentes

    // estado
    const badge = row.querySelector('td:nth-child(3) .badge');
    badge.textContent = item.status;
    badge.className = `badge ${item.status === 'Open' ? 'bg-success':'bg-secondary'}`;

    // preview + lastAt
    row.querySelector('[data-last]') .textContent = item.last ?? '';
    row.querySelector('[data-lastat]').textContent = item.lastAt?.toString().replace('T',' ').slice(0,16) ?? '';

    // unread
    const ub = row.querySelector('[data-unread]');
    if (ub) ub.textContent = (item.unread && item.unread > 0) ? item.unread : '';
    else if (item.unread && item.unread > 0) {
      const span = document.createElement('span');
      span.className = 'badge rounded-pill text-bg-danger';
      span.setAttribute('data-unread','');
      span.textContent = item.unread;
      row.children[row.children.length-1].prepend(span);
    }
  }

  async function poll(){
    try{
      const res = await fetch(API(lastTicks), { credentials:'include' });
      if(!res.ok) return;
      const j = await res.json();
      lastTicks = j.now;
      (j.items || []).forEach(upsertRow);
    }catch{}
  }

  setInterval(poll, 5000);
})();
</script>
}
