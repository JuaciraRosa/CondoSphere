@using System.Globalization
@model CondoSphere.ModelTest.QuotaPayVM

@{
    ViewData["Title"] = "Pay quota";
}

<section class="section">
  <div class="container">
    <h3>Pay quota</h3>

    <p class="text-muted mb-1">@Model.Description</p>
    <p class="fs-5 fw-semibold">
      Amount: @Model.Amount.ToString("C", new CultureInfo("pt-PT"))
    </p>

    @if (TempData["pay_error"] != null)
    {
      <div class="alert alert-danger">@TempData["pay_error"]</div>
    }
    @if (TempData["ok"] != null)
    {
      <div class="alert alert-success">@TempData["ok"]</div>
    }

    <form asp-controller="Quotas" asp-action="StartCheckout" method="post">
      @Html.AntiForgeryToken()
      <input type="hidden" name="id" value="@Model.QuotaId" />
      <button class="btn btn-primary btn-lg">
        <i class="bi bi-credit-card"></i> Pay now
      </button>
    </form>

    <a asp-action="Index" class="btn btn-outline-secondary mt-3">Back</a>
  </div>
</section>
