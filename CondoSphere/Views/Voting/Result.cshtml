@model CondoSphere.Features.Voting.MeetingVoteResultDto
@{
    ViewData["Title"] = $"Vote Results — Meeting {Model.MeetingId}";
}
<section class="page-title">
  <div class="container"><h1>Results</h1></div>
</section>

<div class="container-xl mt-3">
  <div class="card p-3">
    <div class="row g-3">
      <div class="col-md-3"><div class="card card-body"><strong>Total</strong><div>@Model.Total</div></div></div>
      <div class="col-md-3"><div class="card card-body"><strong>A favor</strong><div>@Model.AFavor</div></div></div>
      <div class="col-md-3"><div class="card card-body"><strong>Contra</strong><div>@Model.Contra</div></div></div>
      <div class="col-md-3"><div class="card card-body"><strong>Abstenção</strong><div>@Model.Abstencao</div></div></div>
    </div>
    <div class="mt-3"><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
  </div>
</div>
