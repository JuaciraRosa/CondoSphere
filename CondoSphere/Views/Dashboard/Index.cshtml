@model CondoSphere.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section PageHeader {
  <div class="container py-2">
    <h2 class="mb-0">Dashboard</h2>
  </div>
}

<div class="container">

  @* Admin callout *@
  @if (string.Equals(Model.Role, "Administrator", StringComparison.OrdinalIgnoreCase))
  {
    <div class="alert alert-primary d-flex align-items-start gap-3" role="alert">
      <i class="bi bi-speedometer2 fs-3"></i>
      <div>
        <div class="fw-semibold mb-1">Administrator</div>
        <ul class="mb-0">
          <li>View global financial and operational indicators</li>
          <li>Access company reports and dashboards</li>
        </ul>
      </div>
      <div class="ms-auto d-none d-sm-block">
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-bar-chart-line"></i> Open Reports
        </a>
      </div>
    </div>
  }

  @* Your original three cards (unchanged) *@
  <div class="row">
      <div class="col-md-4">
          <div class="card bg-light mb-3">
              <div class="card-header">Total Companies</div>
              <div class="card-body">
                  <h5 class="card-title">@Model.TotalCompanies</h5>
              </div>
          </div>
      </div>
      <div class="col-md-4">
          <div class="card bg-light mb-3">
              <div class="card-header">Total Condominiums</div>
              <div class="card-body">
                  <h5 class="card-title">@Model.TotalCondominiums</h5>
              </div>
          </div>
      </div>
      <div class="col-md-4">
          <div class="card bg-light mb-3">
              <div class="card-header">Total Users</div>
              <div class="card-body">
                  <h5 class="card-title">@Model.TotalUsers</h5>
              </div>
          </div>
      </div>
  </div>

  @* Optional extra KPIs (only for Admin) *@
  @if (Model.Kpis.Count > 3 && string.Equals(Model.Role, "Administrator", StringComparison.OrdinalIgnoreCase))
  {
    <div class="row g-3">
      @foreach (var k in Model.Kpis.Skip(3).Take(3))
      {
        <div class="col-6 col-md-4">
          <div class="card border-@k.Variant h-100">
            <div class="card-body py-3">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <div class="text-muted small">@k.Title</div>
                  <div class="fs-4 fw-semibold">@k.Value</div>
                  @if (!string.IsNullOrWhiteSpace(k.Subtext))
                  { <div class="small text-muted">@k.Subtext</div> }
                </div>
                <i class="bi @k.Icon fs-2 text-@k.Variant"></i>
              </div>
            </div>
          </div>
        </div>
      }
    </div>
  }

  @* Row 2: Finance + Meetings (only for Admin) *@
  @if (string.Equals(Model.Role, "Administrator", StringComparison.OrdinalIgnoreCase))
  {
    <div class="row g-3 mt-1">
      <div class="col-12 col-xl-6">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-cash-coin me-1"></i> Finance (current month)</span>
            <a asp-controller="Payments" asp-action="Index" class="small">view all</a>
          </div>
          <div class="card-body">
            <div class="row text-center">
              <div class="col-4">
                <div class="text-muted small">Income</div>
                <div class="fs-5 fw-semibold">@Model.Finance.MonthQuotasIn.ToString("C")</div>
              </div>
              <div class="col-4">
                <div class="text-muted small">Expenses</div>
                <div class="fs-5 fw-semibold text-danger">-@Model.Finance.MonthExpenses.ToString("C")</div>
              </div>
              <div class="col-4">
                <div class="text-muted small">Balance</div>
                @{
                  var bal = Model.Finance.MonthBalance;
                  var balClass = bal >= 0 ? "text-success" : "text-danger";
                }
                <div class="fs-5 fw-semibold @balClass">@bal.ToString("C")</div>
              </div>
            </div>

            <hr />

            @* Mini SVG sparkline: payments in the last 6 months *@
            @{
              var vals = Model.Last6MonthsPayments ?? Array.Empty<int>();
              var max = Math.Max(1, vals.DefaultIfEmpty(0).Max());
              var w = 280; var h = 60; var pad = 6;
              var step = (w - pad*2) / Math.Max(1, vals.Length - 1);
              var pts = new System.Text.StringBuilder();
              for (int i = 0; i < vals.Length; i++)
              {
                  var x = pad + i * step;
                  var y = h - pad - (vals[i] / (double)max) * (h - pad*2);
                  pts.Append($"{x},{y} ");
              }
            }
            <div class="small text-muted mb-1">Payments (last 6 months)</div>
            <svg width="100%" height="60" viewBox="0 0 280 60" preserveAspectRatio="none">
              <polyline fill="none" stroke="#0d6efd" stroke-width="2" points="@pts.ToString()"></polyline>
            </svg>

            <div class="small text-muted mt-2">
              Open payments: <span class="badge bg-warning text-dark">@Model.Finance.OpenPayments</span>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-6">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-calendar-event me-1"></i> Upcoming meetings</span>
            <a asp-controller="Meetings" asp-action="Index" class="small">view all</a>
          </div>
          <div class="list-group list-group-flush">
            @if (!(Model.UpcomingMeetings?.Any() ?? false))
            { <div class="list-group-item text-muted">No meetings scheduled.</div> }
            else
            {
              foreach (var m in Model.UpcomingMeetings)
              {
                <a class="list-group-item list-group-item-action" href="@m.Url">
                  <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1">@m.Title</h6>
                    <small class="text-muted">@m.When?.ToLocalTime().ToString("dd/MM HH:mm")</small>
                  </div>
                  @if (!string.IsNullOrWhiteSpace(m.Subtitle))
                  { <p class="mb-1 text-muted">@m.Subtitle</p> }
                </a>
              }
            }
          </div>
        </div>
      </div>
    </div>

    @* Row 3: Announcements + Tickets *@
    <div class="row g-3 mt-1">
      <div class="col-12 col-xl-6">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-megaphone me-1"></i> Recent announcements</span>
            <a asp-controller="Announcements" asp-action="Index" class="small">view all</a>
          </div>
          <div class="list-group list-group-flush">
            @if (!(Model.LatestAnnouncements?.Any() ?? false))
            { <div class="list-group-item text-muted">No announcements.</div> }
            else
            {
              foreach (var a in Model.LatestAnnouncements)
              {
                <a class="list-group-item list-group-item-action" href="@a.Url">
                  <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1">@a.Title</h6>
                    <span class="badge bg-@a.BadgeVariant">@a.Badge</span>
                  </div>
                  @if (!string.IsNullOrWhiteSpace(a.Subtitle))
                  { <small class="text-muted">@a.Subtitle</small> }
                </a>
              }
            }
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-6">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-tools me-1"></i> Maintenance / incidents</span>
            <a asp-controller="MaintenanceRequests" asp-action="Index" class="small">view all</a>
          </div>
          <div class="list-group list-group-flush">
            @if (!(Model.OpenTickets?.Any() ?? false))
            { <div class="list-group-item text-muted">No open tickets.</div> }
            else
            {
              foreach (var t in Model.OpenTickets)
              {
                <a class="list-group-item list-group-item-action" href="@t.Url">
                  <div class="d-flex w-100 justify-content-between align-items-center">
                    <div>
                      <h6 class="mb-1">@t.Title</h6>
                      @if (!string.IsNullOrWhiteSpace(t.Subtitle))
                      { <small class="text-muted">@t.Subtitle</small> }
                    </div>
                    <span class="badge bg-@t.BadgeVariant">@t.Badge</span>
                  </div>
                </a>
              }
            }
          </div>
        </div>
      </div>
    </div>
  }
</div>
