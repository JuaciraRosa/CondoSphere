@model IEnumerable<CondoSphere.Models.Poll>
@{
    ViewData["Title"] = "Manage Polls";
}

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="m-0">Polls</h2>
  <a asp-action="Create" class="btn btn-primary">
    <i class="bi bi-plus-circle"></i> New Poll
  </a>
</div>

<form method="get" class="row g-2 mb-3">
  <div class="col-md-4">
    <label class="form-label">Condominium</label>
  
    <input type="number" name="condominiumId" class="form-control"
           value="@(ViewBag.CondoId is int cid ? cid : null)" placeholder="(optional id)" />
  </div>
  <div class="col-md-2 d-flex align-items-end">
    <button class="btn btn-outline-secondary w-100">Filter</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead class="table-light">
      <tr>
        <th>Title</th>
        <th>Condominium</th>
        <th>Period</th>
        <th>Status</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
    @foreach (var p in Model ?? Enumerable.Empty<CondoSphere.Models.Poll>())
    {
        var now = DateTime.UtcNow;
        var open = p.StartsAtUtc <= now && p.EndsAtUtc > now;
        <tr>
          <td>@p.Title</td>
          <td>@p.Condominium?.Name</td>
          <td>@p.StartsAtUtc.ToLocalTime():g – @p.EndsAtUtc.ToLocalTime():g</td>
          <td>
            @if (open)
            {
              <span class="badge bg-success">Open</span>
            }
            else
            {
              <span class="badge bg-secondary">Closed</span>
            }
          </td>
          <td class="text-end">
            <a asp-action="Result" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">
              <i class="bi bi-bar-chart"></i> Results
            </a>
            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-pencil"></i>
            </a>
            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-trash"></i>
            </a>
          </td>
        </tr>
    }
    </tbody>
  </table>
</div>
