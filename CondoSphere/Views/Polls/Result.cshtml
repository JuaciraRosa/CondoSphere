@model CondoSphere.ViewModels.Polls.PollResultVM
@{
    ViewData["Title"] = "Results";
}

<div class="container-xl">
  <div class="card p-4 shadow-sm">
    <h3 class="mb-2">Results — @Model.Poll.Title</h3>
    <p class="text-muted">Total votes: <strong>@Model.Total</strong></p>

    <ul class="list-group">
      @foreach (var item in Model.Items)
      {
        <li class="list-group-item d-flex justify-content-between align-items-center">
          @item.Text
          <span><strong>@item.Count</strong> (@item.Percent%)</span>
        </li>
      }
    </ul>

    <a asp-action="Index" class="btn btn-outline-secondary mt-3">Back</a>
  </div>
</div>
