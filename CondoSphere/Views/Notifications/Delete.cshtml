@model CondoSphere.Models.Notification
@{
    ViewData["Title"] = "Delete Notification";
}

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title">Delete Notification</h3>
            </div>
            <div class="card-body">
                <h4>Are you sure you want to delete this notification?</h4>
                <dl class="row">
                    <dt class="col-sm-3">Message</dt>
                    <dd class="col-sm-9">@Model.Message</dd>

                    <dt class="col-sm-3">Sent At</dt>
                    <dd class="col-sm-9">@((Model.SentAt.ToString("dd/MM/yyyy HH:mm")) ?? "—")</dd>

                    <dt class="col-sm-3">Condominium</dt>
                    <dd class="col-sm-9">@((Model.Condominium?.Name) ?? $"{Model.CondominiumId}")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
