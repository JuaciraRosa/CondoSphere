@model IEnumerable<CondoSphere.Models.MaintenanceRequest>
@using System.Security.Claims

@{
    ViewData["Title"] = "Maintenance Requests";

    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("role")?.Value;
    var isStaff = string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase)
               || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase);

    // Para o "No records found" ficar com colspan certo
    var cols = isStaff ? 7 : 6;
}

@section PageHeader {
    <section class="page-title">
        <div class="container">
            <h1 class="mb-1">Maintenance Requests</h1>
            <div class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li>Maintenance</li>
                </ol>
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="m-0">Requests</h2>
            <a class="btn btn-success" asp-action="Create">
                <i class="bi bi-plus-lg"></i> New
            </a>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger mb-3">@err</div>
        }

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:180px;">Title</th>
                            <th>Description</th>
                            <th style="width:160px;">Submitted At</th>
                            <th style="width:120px;">Status</th>
                            <th style="min-width:160px;">Condominium</th>
                            @if (isStaff)
                            {
                                <th style="min-width:180px;">Submitted By</th>
                                <th class="text-end" style="width:160px;">Actions</th>
                            }
                            else
                            {
                                <th class="text-end" style="width:80px;">Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in (Model ?? Enumerable.Empty<CondoSphere.Models.MaintenanceRequest>()))
                        {
                            // Badge única (sem duplicar nomes)
                            var statusClass = item.Status switch
                            {
                                CondoSphere.Models.RequestStatus.Open       => "bg-warning text-dark",
                                CondoSphere.Models.RequestStatus.InProgress => "bg-info text-dark",
                                CondoSphere.Models.RequestStatus.Resolved   => "bg-success",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="fw-semibold">@item.Title</td>
                                <td class="text-muted">
                                    @{
                                        string? d = item.Description;
                                        var shortDesc = string.IsNullOrWhiteSpace(d)
                                            ? ""
                                            : (d!.Length <= 90 ? d : d.Substring(0, 90) + "…");
                                    }
                                    @shortDesc
                                </td>
                                <td>@item.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge @statusClass">@item.Status</span></td>
                                <td>@item.Condominium?.Name</td>

                                @if (isStaff)
                                {
                                    <td>@(item.SubmittedBy?.FullName ?? item.SubmittedBy?.Email)</td>
                                }

                                <td class="text-end">
                                    @* Resident: apenas Details *@
                                    @if (!isStaff)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Details" asp-route-id="@item.Id" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Details" asp-route-id="@item.Id" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-action="Delete" asp-route-id="@item.Id" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="@cols" class="text-center text-muted py-4">
                                    No records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
