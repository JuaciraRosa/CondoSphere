@model CondoSphere.Models.ErrorViewModel
@{ ViewData["Title"] = "Erro interno"; }
<div class="container py-5">
  <div class="card shadow-sm">
    <div class="card-body text-center">
      <h1 class="display-4">Ops!</h1>
      <p class="lead">Ocorreu um erro inesperado (500).</p>
      @if (Model?.ShowRequestId ?? false) { <small>Request Id: @Model.RequestId</small> }
      <div class="mt-3">
        <a class="btn btn-primary" href="@Url.Action("Index","Home")">Voltar ao início</a>
      </div>
    </div>
  </div>
</div>
